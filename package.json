{
  "name": "cricketpulse-web",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "format": "npx --yes prettier@3.5.3 --write \"src/**/*.{ts,html,scss,css,json}\"",
    "format:check": "npx --yes prettier@3.5.3 --check \"src/**/*.{ts,html,scss,css,json}\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "legacy:audit": "node scripts/audit-legacy-shims.mjs",
    "quality": "npm run format:check && npm run typecheck && npm run legacy:audit",
    "lint:format": "npm run format:check"
  },
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@stomp/stompjs": "^7.1.1",
    "rxjs": "^7.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "typescript": "~5.6.2"
  }
}
