{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "develop": true
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cricpulse-backend.vercel.app/api/:path*"
    }
  ]
}
